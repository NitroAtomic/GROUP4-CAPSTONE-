# Never commit real credentials -- .env holds the database password and
# JWT secret. .env.example is the safe template that gets committed instead.
.env
.env.local

# Dependencies -- anyone can regenerate these with `npm install`.
# Committing them would add thousands of files to the repo.
node_modules/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Yung CA certificate ng database provider. Hindi ito sikreto -- publiko
# yung certificate ng isang CA -- pero iba ito kada provider at kada
# environment, kaya mas mabuting kunin ng bawat isa yung sarili niya kaysa
# may isang kopyang nauuna nang maluma dito sa repo.
certs/
