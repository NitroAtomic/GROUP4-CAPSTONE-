# Copy this file, rename the copy to exactly ".env", and fill in your own
# values. Never commit the real .env; it is blocked by .gitignore.

# Use "production" when deployed. In production the server refuses to start
# if JWT_SECRET, DB_PASSWORD or CORS_ORIGINS are missing, rather than falling
# back to a value anyone could read in this public repository.
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=seaware
DB_PASSWORD=your-database-password-here
DB_NAME=awareness_platform
# Hosted MySQL providers generally require TLS. Set to true when deployed.
DB_SSL=false

# At least 32 random characters, and different from anything in this file.
# Anyone holding this can forge a login token for any account, admin included.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Which sites the browser may call this API from, comma separated.
# Leave blank locally; the dev server origins are allowed automatically.
# In production set it to your deployed URL, e.g. https://your-app.onrender.com
CORS_ORIGINS=

# Email for one time codes and password resets.
# Leave blank and codes print to the server console instead, which is enough
# to test and demonstrate the whole flow without a mail account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI assistant. Free key from aistudio.google.com/api-keys.
# Leave blank and the assistant answers from the knowledge base instead.
# Model names get retired; if answers stop sounding conversational, check the
# backend log for a 404 naming the replacement.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional alternative to Gemini: an n8n webhook URL. If set, chat messages
# go here instead (n8n owns its own prompt/knowledge base). Checked before
# Gemini, so set at most one of the two if you want a specific provider.
N8N_WEBHOOK_URL=

# --- Mail -------------------------------------------------------------
# Render's free plan blocks outbound SMTP (25, 465, 587), so a Gmail account
# in SMTP_* above will only ever time out there. Mail goes out over Brevo's
# HTTPS API instead, which uses port 443 and is not blocked.
#
# Setting it up: make a free Brevo account, verify ONE sender address you
# own under Senders & IPs (a Gmail is fine - no domain needed), then create
# an API key under SMTP & API. MAIL_FROM must be that verified address or
# Brevo rejects the send.
#
# Leave these empty and the code is written to the server log instead, which
# keeps a fresh clone working without any mail account at all.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=SE-AWARE
